# HaimuAI Server — Environment Variables
# Copy this to .env and fill in your values

# ─── Supabase ───────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Gemini AI ──────────────────────────────────────────────
# Your real Gemini API key (NEVER put this in the Electron app)
GEMINI_API_KEY=AIzaSy-your-real-key-here

# ─── JWT (License Token Signing) ────────────────────────────
# Generate a random 64-char secret: openssl rand -hex 32
JWT_SECRET=replace-with-random-64-char-secret

# ─── Admin Dashboard ────────────────────────────────────────
# Password to access the /admin dashboard
ADMIN_PASSWORD=change-this-password

# ─── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
