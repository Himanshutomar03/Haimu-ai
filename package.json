{
  "name": "haimuai",
  "version": "3.2.0",
  "description": "HaimuAi v3 - Stealth AI Desktop Assistant with voice, screenshots, and AI-powered assistance",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "stealth": "electron . --stealth",
    "launch": "powershell -ExecutionPolicy Bypass -File ./launch.ps1",
    "launch:stealth": "powershell -ExecutionPolicy Bypass -File ./launch.ps1 -Stealth",
    "kill": "powershell -ExecutionPolicy Bypass -File ./launch.ps1 -Kill",
    "obfuscate": "node scripts/obfuscate.js",
    "build": "npm run obfuscate && electron-builder --win",
    "build:mac": "npm run obfuscate && electron-builder --mac",
    "build:all": "npm run obfuscate && electron-builder --win --mac",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir"
  },
  "keywords": [
    "ai",
    "desktop",
    "assistant",
    "screenshot",
    "electron"
  ],
  "author": "HaimuAi",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.2.0",
    "marked": "^12.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^4.2.2"
  },
  "build": {
    "appId": "com.haimuai.desktop",
    "productName": "HaimuAi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "utils/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "utils",
        "to": "utils",
        "filter": ["**/*.ps1", "**/*.js"]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "utils/**/*.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/assets/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "renderer/assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "artifactName": "HaimuAi-${version}.dmg"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HaimuAi"
    },
    "portable": {
      "artifactName": "HaimuAi-Portable.exe"
    }
  }
}
